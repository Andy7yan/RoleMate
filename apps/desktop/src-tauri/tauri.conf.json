{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenJobAgent",
  "version": "0.1.0",
  "identifier": "dev.openjobagent.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenJobAgent",
        "width": 1240,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/open-job-agent-native-host"],
    "category": "Productivity",
    "shortDescription": "Local-first grounded job application copilot",
    "longDescription": "OpenJobAgent helps users discover and prepare job applications using a portable, user-controlled Memory Vault."
  }
}
